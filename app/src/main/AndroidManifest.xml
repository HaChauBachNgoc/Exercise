<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Exercise">

        <!-- 1. Màn hình Khởi động / Đăng nhập -->
        <activity
            android:name="com.example.exercise.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Màn hình Đăng ký & Luồng thiết lập ban đầu -->
        <activity
            android:name="com.example.exercise.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.GoalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.BodyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.ResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Màn hình Trang chủ chính -->
        <activity
            android:name="com.example.exercise.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Thêm món ăn & Thêm vận động -->
        <activity
            android:name="com.example.exercise.AddFoodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.AddWorkoutActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Màn hình Nhật Ký Tổng Quan & Chi Tiết -->
        <activity
            android:name="com.example.exercise.JournalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.FoodJournalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.WorkoutJournalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Lịch sử Cân Nặng & Nước Uống -->
        <activity
            android:name="com.example.exercise.WeightJournalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.WaterJournalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Màn hình Thống kê chính -->
        <activity
            android:name="com.example.exercise.AnalyticsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.UpdateProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.exercise.ProfileActivity2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>